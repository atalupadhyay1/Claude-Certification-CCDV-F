{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5",
  "permissions": {
    "allow": ["Bash(python -m pytest:*)", "Bash(python labs/python/*:*)", "Read", "Grep"],
    "deny": ["Bash(rm -rf:*)", "Bash(curl * | sh:*)", "Read(./.env)", "Read(./**/*.key)"]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python labs/security-hooks/guardrail_hook.py"}]}
    ]
  }
}
